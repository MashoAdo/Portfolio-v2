---
import "../styles/global.css";

const contact = {
  email: "mashoado@gmail.com",
  phone: "+254 724 261 655",
  phoneHref: "tel:+254724261655",
  location: "Kenya",
};

const profiles = [
  { label: "GitHub", href: "https://github.com/MashoAdo" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/masho-ado-36a16a193/",
  },
];

const jobs = [
  {
    role: "Software Engineer",
    company: "GRIFFIN Global Technologies",
    years: "Dec 2025 – now",
    summary: "Web engineering, on-site in Nyeri.",
  },
  {
    role: "Frontend Developer",
    company: "Workpay",
    years: "Oct 2023 – Aug 2025",
    summary:
      "Built performance management tools and feature flagging systems. Implemented CI pipelines and OAuth 2.0 authentication. Integrated AI code review, which cut bugs by 15%.",
  },
  {
    role: "Frontend Engineering Consultant",
    company: "Workpay",
    years: "May – Oct 2023",
    summary: "Contract role before joining full time.",
  },
  {
    role: "Full Stack Engineer",
    company: "Zumi Africa",
    years: "2022 – 2023",
    summary:
      "Developed a B2B e-commerce platform with unified supplier and customer views. Built REST APIs with AdonisJS. Tuned performance to pass Google's Core Web Vitals.",
  },
  {
    role: "Frontend Engineer",
    company: "The Next Stage Lab",
    years: "2022",
    summary:
      "Built web pages with React, Next.js and Bootstrap from UI and UX designs.",
  },
];

const projects = [
  {
    name: "FPL Manager Copilot",
    href: "https://fpl.mashoado.com",
    linkLabel: "fpl.mashoado.com",
    summary:
      "A planning tool for Fantasy Premier League managers: transfers, captain, lineup and chips for the next deadline, each with how sure it is.",
  },
];

const technologies = [
  "TypeScript",
  "React",
  "Next.js",
  "Tailwind CSS",
  "Node.js",
  "AdonisJS",
  "C#",
  ".NET",
  "PostgreSQL",
  "AWS",
  "Docker",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Masho Ado, software engineer in Kenya." />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111113"
      media="(prefers-color-scheme: dark)"
    />
    <title>Masho Ado | Software Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="page">
      <header class="intro">
        <h1>Masho Ado</h1>
        <p class="role">Software Engineer</p>
        <p class="bio">
          I build accessible, carefully made web interfaces, with the backend
          work to go with them. Based in {contact.location}.
        </p>
        <ul class="links">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          {
            profiles.map((l) => (
              <li>
                <a href={l.href} rel="noopener" target="_blank">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </header>

      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        <ol class="list">
          {
            jobs.map((j) => (
              <li class="item">
                <div class="item-head">
                  <h3>
                    {j.role}
                    <span class="at">{j.company}</span>
                  </h3>
                  <p class="when">{j.years}</p>
                </div>
                <p class="text">{j.summary}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        <ul class="list">
          {
            projects.map((p) => (
              <li class="item">
                <div class="item-head">
                  <h3>{p.name}</h3>
                  <a class="when" href={p.href} rel="noopener" target="_blank">
                    {p.linkLabel}
                  </a>
                </div>
                <p class="text">{p.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="technologies">
        <h2 id="technologies">Technologies</h2>
        <ul class="tech">
          {technologies.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <section aria-labelledby="education">
        <h2 id="education">Education</h2>
        <div class="item-head">
          <h3>
            Computer Science
            <span class="at"
              >Jomo Kenyatta University of Agriculture and Technology</span
            >
          </h3>
          <p class="when">2017 – 2021</p>
        </div>
        <p class="text">Second Class Honours (Upper Division)</p>
      </section>

      <footer class="foot">
        <p>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span aria-hidden="true">/</span>
          <a href={contact.phoneHref}>{contact.phone}</a>
        </p>
        <p>© {new Date().getFullYear()} Masho Ado</p>
      </footer>
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(3.5rem, 12vw, 7rem) 1.5rem 3rem;
  }

  section {
    margin-top: 4rem;
  }

  h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .role {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .bio {
    margin: 1.5rem 0 0;
    max-width: 34rem;
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  h2 {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .item-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.1rem 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .at {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }

  .when {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .text {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .foot {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .foot p {
    margin: 0;
  }

  .foot span {
    margin-inline: 0.5rem;
  }
</style>
